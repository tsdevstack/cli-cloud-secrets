{
  "name": "@tsdevstack/cli-cloud-secrets",
  "version": "0.0.1",
  "description": "Cloud secrets management plugin for tsdevstack framework",
  "author": "tsdevstack",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsdevstack/cli-cloud-secrets.git"
  },
  "homepage": "https://github.com/tsdevstack/cli-cloud-secrets",
  "bugs": {
    "url": "https://github.com/tsdevstack/cli-cloud-secrets/issues"
  },
  "keywords": [
    "tsdevstack",
    "cli",
    "secrets",
    "cloud-secrets",
    "gcp",
    "aws",
    "azure"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "tsc": "tsc --noEmit",
    "test": "rstest run"
  },
  "peerDependencies": {
    "@tsdevstack/cli": ">=0.1.0",
    "commander": "^15.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.984.0",
    "@aws-sdk/client-sts": "^3.984.0",
    "@azure/arm-keyvault": "^6.0.0",
    "@azure/arm-resources": "^8.0.0",
    "@azure/identity": "^4.14.0",
    "@azure/keyvault-secrets": "^4.10.0",
    "@google-cloud/secret-manager": "^7.2.0",
    "inquirer": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rslib/core": "^1.0.4",
    "@rstest/adapter-rslib": "^0.12.4",
    "@rstest/core": "^0.12.4",
    "@types/node": "^24.19.2",
    "eslint": "^10.7.0",
    "globals": "^17.5.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.63.0"
  },
  "private": true
}
