{
  "name": "@tsdevstack/cli-cloud-secrets",
  "version": "0.0.1",
  "description": "Cloud secrets management plugin for tsdevstack framework",
  "author": "tsdevstack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsdevstack/cli-cloud-secrets.git"
  },
  "homepage": "https://github.com/tsdevstack/cli-cloud-secrets",
  "bugs": {
    "url": "https://github.com/tsdevstack/cli-cloud-secrets/issues"
  },
  "keywords": [
    "tsdevstack",
    "cli",
    "secrets",
    "cloud-secrets",
    "gcp",
    "aws",
    "azure"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "tsc": "tsc --noEmit",
    "test": "rstest run"
  },
  "peerDependencies": {
    "@tsdevstack/cli": ">=0.1.0",
    "commander": "^12.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.984.0",
    "@aws-sdk/client-sts": "^3.984.0",
    "@azure/arm-keyvault": "^3.2.0",
    "@azure/arm-resources": "^7.0.0",
    "@azure/identity": "^4.13.0",
    "@azure/keyvault-secrets": "^4.10.0",
    "@google-cloud/secret-manager": "^6.1.1",
    "inquirer": "^12.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@rslib/core": "^0.18.2",
    "@rstest/adapter-rslib": "^0.2.0",
    "@rstest/core": "^0.8.5",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "private": false,
  "publishConfig": {
    "access": "restricted"
  }
}
